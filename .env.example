# Host-only file: alimenta la interpolación ${VAR} de docker-compose.yml.
# No se copia ni se monta dentro del contenedor — la app solo lee lo que
# Compose le inyecta vía `environment:`. Ver CLAUDE.md, decisión #12.

# Postgres compartido con el stack de cgho-ops (base de datos y rol propios,
# sin permisos sobre las tablas del otro sistema)
DATABASE_URL=postgresql://bot_role:changeme@postgres:5432/bot_db

# Redis compartido con el stack de cgho-ops (namespaced con prefijo `bot:`)
REDIS_URL=redis://redis:6379/1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# WhatsApp Cloud API (Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# Token compartido con CGHO Sistema de Tickets — solo saliente, este bot lo
# manda como Authorization al llamar a su API. Mismo valor en ambos stacks.
INTERNAL_API_TOKEN=
TICKET_SYSTEM_BASE_URL=http://api:8000

DEBUG=true
